[Unit]
Description=TL-WR902AC Router Monitor and Auto-Recovery
After=network.target docker.service
Wants=network-online.target

[Service]
Type=simple

# ========================================================================
# ⚠️  以下の 5 箇所を自分の環境に合わせて書き換えてください
#
#   確認コマンド:
#     whoami  → User / Group に設定するユーザー名
#     pwd     → このプログラムがある絶対パス（WorkingDirectory に設定）
#
#   setup.sh を使った場合、これらのパスは自動で書き換えられます。
# ========================================================================

WorkingDirectory=/home/roiarise/program/router_reboot_system/router-monitor
ExecStart=/usr/bin/python3 /home/roiarise/program/router_reboot_system/router-monitor/main.py --config /home/roiarise/program/router_reboot_system/router-monitor/config.yaml --env /home/roiarise/program/router_reboot_system/router-monitor/.env

Restart=always
RestartSec=10

User=roiarise
Group=roiarise

# Needed for arping (ICMP/ARP raw sockets) without running as root.
# Remove if config.arp.enabled is false.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# Hardening (optional but recommended)
NoNewPrivileges=true
ProtectSystem=strict

ReadWritePaths=/home/roiarise/program/router_reboot_system/router-monitor/data

[Install]
WantedBy=multi-user.target
